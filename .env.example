# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sellly"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# At-rest encryption for merchant payment credentials (packages/database/src/crypto.ts)
ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# Used by the dashboard's theme customizer to embed a live storefront preview
STOREFRONT_URL="http://localhost:3001"

# AI Store Builder / AI Product Assistant (packages/ai)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Object storage (Cloudflare R2 or S3)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""

# Email (Resend)
RESEND_API_KEY=""
NOTIFICATIONS_FROM_EMAIL="orders@sellly.app"

# WhatsApp (Meta Cloud API) — platform-level app credentials; each store just
# toggles WhatsApp on/off in Settings once these are configured.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Payments — Razorpay (per-store keys are stored encrypted in payment_connections;
# these are only used for platform-level webhooks/tools if needed)
RAZORPAY_WEBHOOK_SECRET=""
