# ─────────────────────────────────────────────────────────────────────────────
# Sellly environment variables
#
# Local development: copy this file to `.env` in the repo root AND to
# `packages/database/.env` (Prisma's CLI reads that one), then fill it in.
# Production: set these in each Vercel project (Settings → Environment
# Variables). The "Apps:" line says which projects need each one.
#
# PUBLIC  = safe if someone sees it (still don't post it around).
# SECRET  = never commit, never put in browser code, never share in chat.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# SECRET. Supabase → Project → Connect → ORMs → Prisma. Use the "Transaction
# pooler" string (port 6543) and add ?pgbouncer=true&connection_limit=1.
# Apps: web, storefront, admin
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# SECRET. Same page, "Direct connection" / "Session pooler" string (port 5432).
# Only used to run migrations. Apps: web, storefront, admin (Prisma requires it
# to be set wherever the schema loads) and your terminal when migrating.
# Local dev: set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Supabase Auth & Storage ──────────────────────────────────────────────────
# PUBLIC. Supabase → Project Settings → API → Project URL.
# Apps: web, admin
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# PUBLIC. Supabase → Project Settings → API → anon / publishable key. Designed
# to be public; the apps only use it on the server anyway. Apps: web, admin
SUPABASE_ANON_KEY="your-anon-key"

# SECRET — the most sensitive value here: it bypasses every Supabase rule.
# Supabase → Project Settings → API → service_role / secret key.
# Used server-side only, for image uploads and the staff/setup scripts.
# Apps: web (uploads), admin (System health storage check). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# PUBLIC. Storage bucket for product/collection images (created by
# `pnpm storage:setup`). Optional — defaults to "store-media". Apps: web, admin
SUPABASE_STORAGE_BUCKET="store-media"

# (Vercel's Supabase integration sets NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY instead; the apps accept those names too.)

# ── App URLs ─────────────────────────────────────────────────────────────────
# PUBLIC. The merchant dashboard's own public address. Used in sign-up
# confirmation and password-reset emails. Apps: web
APP_URL="http://localhost:3000"

# PUBLIC. The storefront's public address. Used for "View store" links and the
# theme preview. Apps: web, admin
STOREFRONT_URL="http://localhost:3001"

# PUBLIC. The storefront's own domain(s), comma-separated, without https://.
# Requests for <store>.<this domain> are served as that store. Leave unset
# while on *.vercel.app (stores are then reached by path). Apps: storefront
STOREFRONT_ROOT_DOMAINS="sellly.app"

# ── Encryption ───────────────────────────────────────────────────────────────
# SECRET. Encrypts merchants' Razorpay keys in the database. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a backup — if it's lost or changed, saved payment keys can't be read.
# Must be identical everywhere it's set. Apps: web, storefront
ENCRYPTION_KEY="generate-with-the-command-above"

# ── AI Store Builder / AI Product Assistant ──────────────────────────────────
# SECRET. console.anthropic.com → API Keys. Optional: AI buttons are hidden
# without it. Apps: web
ANTHROPIC_API_KEY=""
# PUBLIC. Optional model override. Apps: web
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ── Email (Resend) ───────────────────────────────────────────────────────────
# SECRET. resend.com → API Keys. Optional: emails are skipped without it.
# Apps: web, storefront (whichever sends order notifications)
RESEND_API_KEY=""
# PUBLIC. A sender address on a domain you've verified in Resend. Apps: web, storefront
NOTIFICATIONS_FROM_EMAIL="orders@your-domain.com"

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
# SECRET / PUBLIC. developers.facebook.com → your app → WhatsApp → API Setup.
# Optional: each store toggles WhatsApp on in Settings once these exist.
# Apps: web, storefront
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ── Local development & testing only (never set in Vercel) ──────────────────
# Lets `pnpm db:seed` run when NODE_ENV=production. Leave unset.
# ALLOW_SEED="true"
# A throwaway database for the access-control integration tests (wiped data!).
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sellly_test"
